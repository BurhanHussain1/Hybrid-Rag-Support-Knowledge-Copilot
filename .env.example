# Copy this file to .env and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# .env is gitignored; this template is committed so a teammate knows what to set.

# --- Required -------------------------------------------------------------
# Used for answer generation and the citation-verification judge.
OPENAI_API_KEY=sk-replace-me

# --- Qdrant ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=support_chunks

# --- Models ---------------------------------------------------------------
# Embeddings run locally on CPU, so they are free to re-run when chunking changes.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gpt-4o-mini

# --- Retrieval knobs ------------------------------------------------------
# These are the levers your evaluation report compares. Change one at a time.
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=1.0
RERANK_TOP_N=20
FINAL_TOP_K=5

# --- Chunking -------------------------------------------------------------
CHUNK_STRATEGY=heading
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=200
MAX_CHUNK_CHARS=1600

# --- Confidence -----------------------------------------------------------
# Below this, the assistant refuses instead of guessing.
MIN_CONFIDENCE=0.35
